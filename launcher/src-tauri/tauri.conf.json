{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgottenLandLauncher",
  "version": "0.3.3",
  "identifier": "xyz.kfl-recomp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forgotten Land Recomp",
        "width": 1040,
        "height": 600,
        "minWidth": 900,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
